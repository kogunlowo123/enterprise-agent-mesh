{
  "id": null,
  "title": "Enterprise Agent Mesh - Platform Overview",
  "tags": ["agent-mesh", "platform"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Mesh Healthy Nodes",
      "type": "stat",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(mesh_node_healthy{job=\"enterprise-agent-mesh\"})",
          "legendFormat": "Healthy Nodes"
        }
      ]
    },
    {
      "id": 2,
      "title": "Circuit Breaker States",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 8, "x": 4, "y": 0},
      "targets": [
        {
          "expr": "count by (circuit_state) (mesh_circuit_state{job=\"enterprise-agent-mesh\"})",
          "legendFormat": "{{circuit_state}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Routing Latency P99",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(mesh_routing_duration_seconds_bucket[5m]))",
          "legendFormat": "P99 Latency"
        }
      ]
    },
    {
      "id": 4,
      "title": "Circuit State Changes",
      "type": "graph",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "rate(circuit_state_changes_total[5m])",
          "legendFormat": "{{node_id}} {{new_state}}"
        }
      ]
    }
  ]
}
